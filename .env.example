# TrustLens AI — Environment Configuration Example
# Copy this file to .env and configure as needed.

APP_NAME=TrustLens AI
APP_VERSION=1.0.0
DEBUG=false
ENV=production

# Server & Routing
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# Rate Limiting & Safety
RATE_LIMIT_PER_MINUTE=60/minute
MAX_MESSAGE_LENGTH=5000
REDACT_SENSITIVE_DATA_IN_STORAGE=true

# Database Storage
# Default SQLite local database file
DATABASE_URL=sqlite:///./trustlens.db
# For PostgreSQL migration (optional):
# DATABASE_URL=postgresql://user:password@localhost:5432/trustlens

# AI Investigation Provider
# Options: "auto" (uses Bedrock if AWS creds present, else falls back to Rule-Based NLP), "bedrock", "rule_based_fallback"
LLM_PROVIDER=auto

# Optional Amazon Bedrock Integration (Hackathon Track)
# Leave blank to use zero-cost built-in Rule-Based NLP Investigation Engine
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_TIMEOUT_SECONDS=8
